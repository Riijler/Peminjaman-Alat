PORT=4000
# Ganti dengan string acak panjang (min 16 karakter), contoh: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=8h
# Buat database MySQL terlebih dahulu: CREATE DATABASE peminjaman_alat;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peminjaman_alat
DB_TEST_NAME=peminjaman_alat_test
DB_CONNECTION_LIMIT=10
# Boleh lebih dari satu, pisahkan koma
CLIENT_ORIGIN=http://localhost:5173
# Denda per hari keterlambatan (Rupiah)
FINE_PER_DAY=1000
LOGIN_RATE_LIMIT=10
